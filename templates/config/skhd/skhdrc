.shell "/bin/bash"

# ── templates ─────────────────────────────────────────────────────────
.define toggle : ~/.config/skhd/bin/toggle_app "{{1}}"
.define focus  : yabai -m window --focus {{1}}
.define grid   : yabai -m window --grid {{1}}
.define layout : yabai -m space --layout {{1}}

# ── apps (bundle IDs) ─────────────────────────────────────────────────
hyper - m : @toggle("com.apple.ActivityMonitor")
hyper - b : @toggle("com.brave.Browser")
hyper - d : @toggle("org.jkiss.dbeaver.core.product")
hyper - f : @toggle("com.apple.finder")
hyper - o : @toggle("md.obsidian")
hyper - w : @toggle("com.microsoft.Word")
hyper - x : @toggle("com.mitchellh.ghostty")
hyper - v : @toggle("com.vscodium")
hyper - t : @toggle("com.microsoft.teams2")

# ── focus (bsp) ───────────────────────────────────────────────────────
alt - h : @focus("west")
alt - j : @focus("south")
alt - k : @focus("north")
alt - l : @focus("east")

# ── half-tiling ───────────────────────────────────────────────────────
shift + alt - h : @grid("1:2:0:0:1:1")
shift + alt - l : @grid("1:2:1:0:1:1")
shift + alt - k : @grid("2:1:0:0:1:1")
shift + alt - j : @grid("2:1:0:1:1:1")

# ── pin / unpin ───────────────────────────────────────────────────────
alt - p         : yabai -m window --sub-layer above
shift + alt - p : yabai -m window --sub-layer below

# ── windowed fullscreen ───────────────────────────────────────────────
alt - m : ~/.config/skhd/bin/fs_ax

# ── space layout ──────────────────────────────────────────────────────
alt - b         : @layout("bsp")
shift + alt - b : yabai -m space --layout float; yabai -m query --windows --space | jq -r '.[].id' | while read id; do yabai -m window "$id" --toggle windowed-fullscreen; done
